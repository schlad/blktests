#
# Degraded-mode sanity test: RAID 1, 5, 6, 10. For each of these
# redundant raid levels, create an array on defined block devices, start a
# sustained fio write, then fail one member while that write is still
# in flight. Verifies the array reports degraded rather than healthy or
# dead, and that the write completes successfully across the
# healthy -> degraded transition.

. tests/md/rc

DESCRIPTION="degraded-mode defined for RAID 1/5/6/10 on real block devices"

requires() {
	_have_fio
	_require_md_raid
}

device_requires() {
	_require_test_dev_size 512m
}

test_device_array() {
	echo "Running ${TEST_NAME}"

	if [[ ${#TEST_DEV_ARRAY[@]} -lt 4 ]]; then
		SKIP_REASONS+=("requires at least 4 test devices")
		return 1
	fi

	local level ndevs mddev fail_dev count fio_pid

	for level in $MD_RAID_LEVELS; do
		[[ "$level" == 0 ]] && continue
		echo "Testing raid${level}" >>"$FULL"

		if ! _have_md_level "$level"; then
			continue
		fi

		ndevs=$(_md_min_devices "$level")
		mddev=$(_md_create_array "$level" "${TEST_DEV_ARRAY[@]:0:$ndevs}")
		fail_dev="${TEST_DEV_ARRAY[1]}"

		if ! _md_status "$mddev"; then
			echo "raid${level} array did not reach a healthy state"
			_md_detail "$mddev"
		fi

		# Fail the device while fio is still writing, so the array has
		# to keep serving in-flight writes correctly through the
		# healthy -> degraded transition.
		_run_fio_verify_io --filename="$mddev" --size=128M \
			--time_based --runtime=10 &
		fio_pid=$!

		mdadm --quiet "$mddev" --fail "$fail_dev" >/dev/null 2>&1

		count=0
		until _md_is_faulty "$mddev"; do
			if ! kill -0 "$fio_pid" 2>/dev/null; then
				echo "raid${level} fio finished before the device was marked faulty"
				break
			fi
			sleep 1
			count=$((count + 1))
			if ((count >= 10)); then
				echo "timed out waiting for raid${level} device to be marked faulty"
				break
			fi
		done

		if ! _md_status_is_degraded "$mddev"; then
			echo "raid${level} array did not report degraded after a device failure"
			_md_detail "$mddev"
		fi

		if ! wait "$fio_pid"; then
			echo "raid${level} fio write failed while the array became degraded"
		fi

		mdadm --quiet --stop "$mddev" >/dev/null 2>&1
	done

	echo "Test complete"
}
